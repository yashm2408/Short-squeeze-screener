# Finviz Elite API token (found on your Finviz Elite account page)
FINVIZ_API_KEY=your_finviz_api_key_here

# Finviz session cookie (found in browser dev tools after logging into elite.finviz.com)
# Used as a fallback auth method — more stable than the API token
FINVIZ_ASPXAUTH=your_aspxauth_cookie_here